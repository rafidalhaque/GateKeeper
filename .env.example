# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
DEBUG=True

# Database Configuration
# For PostgreSQL (recommended):
DATABASE_URL=postgresql://user:password@localhost:5432/gatekeeper
# For MySQL (alternative):
# DATABASE_URL=mysql://user:password@localhost:3306/gatekeeper

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=your-jwt-secret

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=GateKeeper Event System

# Application Configuration
APP_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# Super Admin Configuration (Optional - CLI is recommended)
# Remove these after initial setup for security
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_PASSWORD=change_this_password

# Security
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# File Upload
MAX_CONTENT_LENGTH=16777216  # 16MB max file size
UPLOAD_FOLDER=uploads

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']
CELERY_TIMEZONE=UTC

# Test configuration
BASE_URL=http://localhost:5000
TEST_EMAIL=address@email.tld
TEST_PASSWORD=your-password